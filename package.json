{
  "name": "advocatra-mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local, read-only MCP server for Advocatra — decrypts a vault locally, never on the cloud.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "check:spdx": "node scripts/check-spdx.mjs",
    "check:licenses": "node scripts/license-scan.mjs",
    "check:no-write-tools": "node scripts/check-no-write-tools.mjs",
    "start": "tsx src/index.ts"
  },
  "dependencies": {
    "@advocatra/billing": "workspace:*",
    "@advocatra/case": "workspace:*",
    "@advocatra/crypto": "workspace:*",
    "@advocatra/vault": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.4",
    "@types/node": "^22.10.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
